@startuml architecture
!define RECTANGLE_COLOR #1E3A5F
!define TOOL_COLOR #2D5F8A
!define DATA_COLOR #2A4D3A
!define LLM_COLOR #4A3A6B
!define GUARD_COLOR #8B4513

skinparam backgroundColor #0D1117
skinparam defaultTextColor #E8EDF7
skinparam defaultFontSize 13
skinparam rectangle {
  BackgroundColor #161B22
  BorderColor #30363D
  RoundCorner 12
}
skinparam arrow {
  Color #58A6FF
  FontSize 11
}
skinparam package {
  BackgroundColor #161B22
  BorderColor #30363D
}

title **PrepRight — Agent Architecture**\n<size:11>Agentic AI Math Tutor for CBSE Classes 5-10</size>

package "Client" {
  rectangle "Chat UI\n<back:#1E3A5F>quiz cards + tool chips</back>" as UI
  rectangle "Parent Dashboard\n<back:#1E3A5F>PrepScore + reports</back>" as PARENT
}

package "FastAPI Server" {
  rectangle "Guardrail Node\n<back:#8B4513>PII redaction + topic screen</back>\n<color:#FF6B6B>zero-token exits</color>" as GUARD #RECTANGLE_COLOR
  rectangle "Agent Node\n<back:#2D5F8A>LLM + 8 tools bound</back>\n<color:#58A6FF>conditional edge: tool_calls?</color>" as AGENT #RECTANGLE_COLOR
  rectangle "Tools Node\n<back:#2D5F8A>executes OUR code</back>\n<color:#3FCF8E>errors = results, not crashes</color>" as TOOLS #RECTANGLE_COLOR
}

package "LLM Gateway\n<color:#C084FC>provider firewall</color>" as GW {
  rectangle "gpt-oss-120b\n<color:#3FCF8E>primary</color>" as M1 #LLM_COLOR
  rectangle "gpt-oss-20b\n<color:#FFB84D>fallback (own quota)</color>" as M2 #LLM_COLOR
  rectangle "Gemini 3.5\n<color:#9AA7C4>cross-provider</color>" as M3 #LLM_COLOR
}

package "Tools" {
  rectangle "generate_quiz\n<back:#2D5F8A>sympy-verified</back>" as T1 #TOOL_COLOR
  rectangle "grade_quiz\n<back:#2D5F8A>server-side grading</back>" as T2 #TOOL_COLOR
  rectangle "lookup_concept\n<back:#2D5F8A>RAG retrieval</back>" as T3 #TOOL_COLOR
  rectangle "calculate\n<back:#2D5F8A>sympy arithmetic</back>" as T4 #TOOL_COLOR
  rectangle "record_progress\n<back:#2D5F8A>SQLite + clamps</back>" as T5 #TOOL_COLOR
}

package "Data" {
  database "SQLite\n<back:#2A4D3A>progress + parents</back>" as DB #DATA_COLOR
  database "curriculum.json\n<back:#2A4D3A>versioned spine</back>" as CURR #DATA_COLOR
  database "checkpoints.db\n<back:#2A4D3A>per-student memory</back>" as CKPT #DATA_COLOR
}

UI -down-> GUARD : <color:#58A6FF>SSE stream
GUARD -down-> AGENT : <color:#3FCF8E>pass
GUARD -left-> UI : <color:#FF6B6B>blocked (canned)
AGENT -down-> TOOLS : <color:#58A6FF>tool_call
TOOLS -up-> AGENT : <color:#3FCF8E>ToolMessage (loop back)
AGENT -right-> M1
M1 -down-> M2 : <color:#FF6B6B>fail
M2 -down-> M3 : <color:#FF6B6B>fail
TOOLS --> T1
TOOLS --> T2
TOOLS --> T3
TOOLS --> T4
TOOLS --> T5
T1 --> DB
T1 --> CURR
T3 --> CURR
T5 --> DB
PARENT -down-> DB : <color:#58A6FF>session auth
@enduml
