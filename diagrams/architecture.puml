@startuml
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontSize 12
skinparam roundCorner 10
skinparam rectangle {
  BackgroundColor #F0F4F8
  BorderColor #2C3E50
  FontColor #2C3E50
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #78909C
  FontStyle bold
}
skinparam arrow {
  Color #546E7A
  FontSize 11
  FontColor #546E7A
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #5D4037
}

title PrepRight - Agent Architecture

package "Client" {
  rectangle "Kid Picker\n(avatar cards)" as PICKER
  rectangle "Chat UI\nquiz cards + grading" as UI
  rectangle "Parent Dashboard\nPrepScore + reports" as PARENT
}

package "FastAPI Server" {
  rectangle "Guardrail\nPII redaction\n+ regex fast-pass\n+ non-math fast-reject\n+ LLM classifier" as GUARD
  rectangle "Agent Node\nLLM + 8 tools\n(recursion_limit=16)" as AGENT
  rectangle "Tools Node\nreal code execution\n+ identity injection" as TOOLS
}

package "LLM Gateway (firewall)" {
  rectangle "gpt-oss-120b" as M1
  rectangle "gpt-oss-20b\n(same-provider)" as M2
  rectangle "Gemini 3.5 Flash\n(cross-provider)" as M3
}

package "Tools (8)" #F3E5F5 {
  rectangle "generate_quiz\nsympy-verified" as T1
  rectangle "grade_quiz\none server-side call" as T2
  rectangle "grade_answer\nsingle-question" as T3
  rectangle "lookup_concept\nRAG retrieval" as T4
  rectangle "calculate\nsympy arithmetic" as T5
  rectangle "record_progress\nclamped writes" as T6
  rectangle "get_student_profile\nmastery history" as T7
  rectangle "get_curriculum\nchapter + marks" as T8
}

package "Data" {
  database "SQLite\nprogress + parents\n+ auth_sessions" as DB
  database "checkpoints.db\nper-student\nconversation memory" as CKPT
  database "curriculum.json\nversioned 5-10" as CURR
  database "math_concepts.json\n15 RAG cards" as CONCEPTS
  database "quiz cache\n(24h TTL)" as QCACHE
  database "embeddings cache\n(disk, content-hash)" as EMB
}

PICKER -down-> UI : tap avatar
UI -down-> GUARD : SSE stream
GUARD -down-> AGENT : pass
AGENT -down-> TOOLS : tool_call
TOOLS -up-> AGENT : result (loop)
AGENT -right-> M1
M1 -down-> M2 : fail
M2 -down-> M3 : fail
TOOLS --> T1
TOOLS --> T2
TOOLS --> T3
TOOLS --> T4
TOOLS --> T5
TOOLS --> T6
TOOLS --> T7
TOOLS --> T8
T1 --> QCACHE
T1 --> CURR
T4 --> CONCEPTS
T4 --> EMB
T6 --> DB
T7 --> DB
PARENT --> DB : Bearer auth
note right of TOOLS
  student_id injected
  server-side (model
  never supplies identity)
end note
note right of GUARD
  Off-topic: regex pass ->
  fast-reject -> LLM
  classifier (fail-open)
end note
@enduml
