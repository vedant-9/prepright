# Copy this file to .env and fill in your keys.
# Get a FREE Gemini key (no credit card): https://aistudio.google.com/apikey

# --- LLM provider chain ---------------------------------------------
# Primary + same-provider fallback (separate quota buckets per model),
# then cross-provider fallback to Gemini. All free tiers, no card.
# Free Groq key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Cross-provider fallback. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Runtime flags ----------------------------------------------------
# true = serve cached/replayed responses (never fails a live demo on quota)
DEMO_MODE=false
