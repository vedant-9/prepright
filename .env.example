# Copy this file to .env and fill in your keys.
# Get a FREE Gemini key (no credit card): https://aistudio.google.com/apikey

# --- LLM provider chain ---------------------------------------------
# Primary. Gemini free tier: generous quota for Flash models.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback (optional but recommended). Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Runtime flags ----------------------------------------------------
# true = serve cached/replayed responses (never fails a live demo on quota)
DEMO_MODE=false
