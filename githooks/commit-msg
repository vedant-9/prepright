#!/bin/sh
# commit-message guard - no process markers in messages.
# Private patterns: .commit-guard at repo root (same file pre-commit reads).
set -e
msg=$(cat "$1")

patterns='^P[0-9]+(\.[0-9]+)?[: ]|\bPOC\b|\bpilot\b'
if [ -f .commit-guard ]; then
  extra=$(grep -v '^#' .commit-guard | grep -v '^$' | paste -sd'|' - || true)
  [ -n "$extra" ] && patterns="$patterns|$extra"
fi

hits=$(echo "$msg" | grep -inE "$patterns" || true)
if [ -n "$hits" ]; then
  echo "BLOCKED: process marker in commit message: $hits"
  exit 1
fi
exit 0
